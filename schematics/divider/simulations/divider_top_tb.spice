** sch_path: /foss/designs/CHIP-PLL/schematics/divider/tb/divider_top_tb.sch
**.subckt divider_top_tb
V1 VP 0 {vdd}
V2 clk 0 PULSE(0 {vdd} 0 100p 100p 1.5625n 3.125n)
V8 d4 0 0
V9 d5 0 0
V11 d0 0 0
V10 d1 0 {vdd}
V12 d2 0 0
V7 d3 0 0
V5 a1 0 0
V6 a0 0 {vdd}
V13 a2 0 0
x1 0 VP clk d0 d1 d2 d3 d4 d5 a0 a1 a2 out_div reset Divider_top
V4 reset 0 PWL( 0 {vdd} 200n {vdd} 200.1n 0)
C1 out_div 0 50f
**** begin user architecture code


.options savecurrents
.temp -40
.param vdd=1.2
.control
set num_threads=12
set maxdata = 1000
op
print all
save v(out_div)


tran 25p 400n

write divider_top_tb.raw
set appendwrite

.endc


 .lib cornerMOSlv.lib mos_sf

**** end user architecture code
**.ends

