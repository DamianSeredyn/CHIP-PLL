x9 1 2 vp gd inverter_x8
x1 clk_n vp D 1 gd clk PFD_passgate
XM1 gd 1 gd gd sg13_lv_nmos w=5u l=5u ng=1 m=1 mm_ok=1
XM2 gd 3 gd gd sg13_lv_nmos w=5u l=5u ng=1 m=1 mm_ok=1
