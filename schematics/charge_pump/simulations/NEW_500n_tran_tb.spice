.temp -25
.param Vp=1.08
.param rsh_rhigh=1000
.control

op
tran 10n 300u
save all
wrdata cp_test.txt v(vout) v(x1.biasn) v(x1.biasp) i(v.x1.Viup) i(v.x1.Vidn)
write cp_test.raw

set filetype=ascii

set appendwrite
.endc


