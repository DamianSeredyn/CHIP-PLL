** sch_path: /foss/designs/CHIP-PLL/schematics/PFD/PFD_CP_tb.sch
**.subckt PFD_CP_tb
Vref CRef_prebuf GND dc 0 ac 0 pulse(0 {Vph} {T/2} 10n 10n {T/2} {T})
Vco CVco GND dc 0 ac 0 pulse(0 {Vp} {dly} 10n 10n {T/2} {T})
Vp vp GND dc {Vp}
x2 vp CRef_prebuf CRef GND buffer_hv
x1 GND vp CRef UP DOWN CVco rst PFD_cell_2
x3 vp UP out_preRC DOWN rst_n GND charge_pump_cell
Vp1 rst GND dc 0 ac 0 PULSE({Vp} 0 63u 1p 1p 1 2
x4 rst rst_n vp GND inverter_x4
x5 out out_preRC GND RC_filter
**** begin user architecture code
 .lib cornerMOSlv.lib mos_tt
.lib cornerRES.lib res_typ
.lib cornerMOShv.lib mos_tt



.temp=25
.param T = 31.25u
.param dly=1u
.param Vp=1.2
.param Vph=3.3
.control
save all
tran 25n 300u

meas tran pw_up avg v(UP) from=100u to=1m
meas tran pw_down avg v(DOWN) from=100u to=300u
plot v(pw_up) v(pw_down) v(out)
write PFD_tb.raw
.endc


**** end user architecture code
**.ends

