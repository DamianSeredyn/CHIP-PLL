** sch_path: /foss/designs/CHIP-PLL/schematics/misc/level_shifter_tb.sch
**.subckt level_shifter_tb
x1 vph aft_LS vp pre_LS GND level_shifter
V1 vp GND {Vp}
V2 vph GND {Vph}
C1 out GND 20p
Vco in GND dc 0 ac 0 pulse(1u {Vp} 0 10p 10p {T/2} {T})
x5 out_PLL_divided vp GND net1 in net1 d_flip_flop
x2 out_PLL_divided net2 vp GND inverter_x2
x3 net2 pre_LS vp GND inverter_x4
xBUF1 vph aft_LS out GND buf
**** begin user architecture code
 .lib cornerMOSlv.lib mos_tt



.temp=25
.param T = 5n
.param Vp=1.2
.param Vph=3.3
.control
save all

tran 0.5n 100n

meas tran VOUT_MAX MAX v(out) from=75n to=100n

meas tran VOUT_AVG AVG v(out) from=75n to=100n


plot v(VOUT_MAX) v(VOUT_AVG)
write level_shifter.raw
.endc


 .lib cornerMOShv.lib mos_tt

**** end user architecture code
**.ends

